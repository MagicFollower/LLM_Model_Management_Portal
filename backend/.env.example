# ============================================================
# ModelSpace 后端环境变量配置
# 复制本文件为 .env 并按需修改，启动前 source / import 到 shell
# ============================================================

# ---- Embedding 模型 ----
# 模型标识（硬编码于 config.py，此处仅文档用途）
# MODEL_ID=BAAI/bge-small-zh-v1.5
# DIMENSION=512

# HuggingFace 缓存目录（默认 backend/.cache/huggingface）
# HF_CACHE_DIR=/path/to/cache

# 本地模型路径（设置后离线加载，不联网）
# MODEL_PATH=C:\Users\X\Desktop\模型管理系统\backend\.cache\huggingface\bge-small-zh-v1.5

# HuggingFace 镜像站（国内网络）
# HF_ENDPOINT=https://hf-mirror.com

# ---- BM25 关键词检索 ----
# 设为 true 启用 BM25 通道（纯算法，无需额外模型）
BM25_ENABLED=true

# ---- Reranker 重排序 ----
# 设为 true 启用 Reranker（需先下载 bge-reranker-v2-m3 模型 ~2GB）
RERANKER_ENABLED=true

# 本地 Reranker 模型路径（必须指向 snapshots/<hash>/ 目录）
# RERANKER_MODEL_PATH=C:\Users\X\Desktop\模型管理系统\backend\.cache\huggingface\models--BAAI--bge-reranker-v2-m3\snapshots\<hash>

# 送入 Reranker 的候选数上限（默认 20，限制 CPU 负载）
RERANKER_TOP_N=20

# Reranker 超时时间（秒，默认 30，超时自动降级）
RERANKER_TIMEOUT=30

# Reranker 批处理大小（默认 8，减少内存峰值）
RERANKER_BATCH_SIZE=8

# ---- 混合检索权重 ----
# 向量权重 + BM25 权重建议合计为 1.0
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# ---- 服务配置 ----
HOST=127.0.0.1
PORT=8001

# ---- 限制配置（通常无需修改） ----
# MAX_CHUNKS=512
# MAX_CHUNK_CONTENT=4000
# MAX_TOTAL_CONTENT=200000
# MAX_QUERY_LENGTH=2000
# MAX_REQUEST_BYTES=2097152
# LRU_CAPACITY=2048
